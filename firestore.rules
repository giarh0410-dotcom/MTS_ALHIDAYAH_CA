rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }
    function isSignedIn() {
      return request.auth != null;
    }

    match /{document=**} {
      allow read, write: if false;
    }

    match /students/{studentId} {
      allow read, write: if isValidId(studentId);
    }

    match /news/{newsId} {
      allow read, write: if isValidId(newsId);
    }

    match /media/{mediaId} {
      allow read, write: if isValidId(mediaId);
    }

    match /alumni/{alumniId} {
      allow read, write: if isValidId(alumniId);
    }
  }
}
